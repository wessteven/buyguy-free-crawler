<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/token_row" style="@style/RadarRow">
    <ImageView android:id="@+id/token_logo" style="@style/RadarLogo" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/token_symbol" style="@style/RadarSymbol" />
            <TextView android:id="@+id/token_price" style="@style/RadarPrice" />
        </LinearLayout>
        <TextView android:id="@+id/token_details" style="@style/RadarDetails" />
    </LinearLayout>
</LinearLayout>
